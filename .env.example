# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=idim_db

# Google OAuth 2.0 Credentials (Gmail Integration)
# In Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Client ID):
# - Application type: Web application
# - Authorized redirect URI: http://localhost:8000/api/v1/email/gmail/callback
# - Scopes: openid, https://www.googleapis.com/auth/userinfo.email, https://www.googleapis.com/auth/userinfo.profile, https://www.googleapis.com/auth/gmail.readonly, https://www.googleapis.com/auth/drive.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/email/gmail/callback
FRONTEND_URL=http://localhost:5173

# Fernet key for encrypting OAuth tokens at rest
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# RabbitMQ (optional)
RABBITMQ_USER=idim
RABBITMQ_PASSWORD=idim

# Scanning (optional)
# SCAN_INTERVAL_MINUTES=30
# SCAN_STALE_MINUTES=30
# SCAN_CONCURRENCY=5
# SCAN_BATCH_SIZE=10
# SCAN_MAX_ATTEMPTS=12
# GMAIL_MAX_IN_FLIGHT=2
# SCAN_RETRY_BASE_SECONDS=2
# SCAN_RETRY_MAX_SECONDS=60
# SCAN_PACING_SPREAD_SECONDS=30
# Gmail per-user quota budget (Google: 6,000 units/min; a full message fetch costs 60)
# GMAIL_QUOTA_UNITS_PER_MINUTE=6000
# GMAIL_QUOTA_UTILISATION=0.9
# GMAIL_QUOTA_WINDOW_SECONDS=10
